pub use std::iter::{
    intersperseIter::intersperse,
    mapIter::map,
    peekable::{ peekable, peek },
    takeWhile::takeWhile,
}

pub trait Iterable<T> {
    iter = fn<I: Iter<T>>(self): I
}

pub trait Iter<T> {
    next = fn(self): Option<T>

    count = fn(self): Int {
        self.fold(fn(acc, _) { acc + 1 }, 0)
    }

    last = fn(self): Option<T> {
        let res = None()
        for item in self {
            res = Some(item)
        }
        return res
    }

    fold = fn<U>(self, f: fn(acc: U, item: T): U, initial: U): U {
        let res = initial
        for item in self {
            res = f(res, item)
        }
        return res
    }

    find = fn(self, f: fn(elem: T): Bool): Option<T> {
        for n in self {
            match f(n) {
                true { return Some(n) }
            }
        }
        None()
    }

    collect = fn<C: Collector<T>>(self): C {
        fromIter<C>(self)
    }

    position = fn(self, f: fn(elem: T): Bool): Option<Int> {
        let i = 0
        for n in self {
            match f(n) {
                true { return Some(i) }
            }
            i = i + 1
        }
        None()
    }
}

impl <T> Iterable<T> for Iter<T> {
    iter = fn(self): Iter<T> {
        return self
    }
}

pub trait Collector<T> {
    fromIter = fn<I: Iter<T>>(iter: I): Self
}
