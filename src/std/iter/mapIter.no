pub type MapIter<T, U>(
    iter: Iter<T>,
    f: fn(value: T): U
)

impl <T, U> Iter<U> for MapIter<T, U> {
    next = fn(self): Option<U> {
        self.iter.next().map(self.f)
    }
}

pub trait MapAdapter<T> {
    map = fn<U>(self, f: fn(elem: T): U): Iter<U>
}

impl <T> MapAdapter<T> for Iter<T> {
    map = fn<U>(self, f: fn(elem: T): U): Iter<U> {
        MapIter(iter: self, f)
    }
}

