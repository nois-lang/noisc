pub type TakeWhileIter<T>(
    iter: Iter<T>,
    f: fn(item: T): Bool,
    done: Bool
)

impl <T> Iter<T> for TakeWhileIter<T> {
    next = fn(self): Option<T> {
        match self.done { 
            true { return None() }
        }
        match self.iter.next() {
            Some(value) {
                match value.{self.f}.not() {
                    true {
                        self.done = true
                        return None()
                    }
                }
                Some(value)
            }
            _ { None() }
        }
    }
}

pub trait TakeWhileAdapter<T> {
    takeWhile = fn(self, f: fn(item: T): Bool): Iter<T>
}

impl <T> TakeWhileAdapter<T> for Iter<T> {
    takeWhile = fn(self, f: fn(item: T): Bool): Iter<T> {
        TakeWhileIter(iter: self, f, false)
    }
}

