use std::iter::range::RangeIter

pub type RepeatIter<T> (
    range: RangeIter,
    item: T
)

impl <T> Iter<T> for RepeatIter<T> {
    next = fn(self): Option<T> {
        let n = self.range.next()
        match n {
            Some() { Some(self.item) }
            None() { None() }
        }
    }
}

pub let repeat = fn<T>(item: T, count: Int): RepeatIter<T> {
    RepeatIter(range: RangeIter::RangeIter(0, count), item)
}

