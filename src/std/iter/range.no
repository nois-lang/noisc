pub type RangeIter (
    head: Int,
    end: Int
)

impl Iter<Int> for RangeIter {
    fn next(self): Option<Int> {
        match self.head < self.end {
            true {
                let n = Some(self.head.copy())
                self.head = self.head + 1
                n
            }
            false {
                None()
            }
        }
    }
}

pub fn range(start: Int, end: Int): RangeIter<Int> {
    RangeIter::RangeIter(head: start, end)
}

pub fn rangeClosed(start: Int, end: Int): RangeIter<Int> {
    RangeIter::RangeIter(head: start, end: end + 1)
}

