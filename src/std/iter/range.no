pub type RangeIter (
    head: Int,
    end: Int
)

impl Iter<Int> for RangeIter {
    next = fn(self): Option<Int> {
        match self.head < self.end {
            true {
                let n = Some(self.head.copy())
                self.head = self.head + 1
                n
            }
            false {
                None()
            }
        }
    }
}

pub let range = fn(start: Int, end: Int): RangeIter {
    RangeIter(head: start, end)
}

pub let rangeClosed = fn(start: Int, end: Int): RangeIter {
    RangeIter(head: start, end: end + 1)
}

