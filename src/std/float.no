pub type Float

impl Num for Float {
    neg = fn(self): Self {
        negFloat(self)
    }

    abs = fn(self): Self {
        absFloat(self)
    }

    add = fn(self, other: Self): Self {
        addFloat(self, other)
    }

    sub = fn(self, other: Self): Self {
        subFloat(self, other)
    }

    mult = fn(self, other: Self): Self {
        multFloat(self, other)
    }

    div = fn(self, other: Self): Self {
        divFloat(self, other)
    }

    exp = fn(self, other: Self): Self {
        expFloat(self, other)
    }
}

impl Eq for Float {
    eq = fn(self, other: Self): Bool {
        eqFloat(self, other)
    }
}

impl Show for Float {
    show = fn(self): String {
        showFloat(self)
    }
}

impl Trace for Float {
    trace = fn(self): String {
        self.show()
    }
}

impl Copy for Float {}

let negFloat = fn(a: Float): Float

let absFloat = fn(a: Float): Float

let addFloat = fn(a: Float, b: Float): Float

let subFloat = fn(a: Float, b: Float): Float

let multFloat = fn(a: Float, b: Float): Float

let divFloat = fn(a: Float, b: Float): Float

let expFloat = fn(a: Float, b: Float): Float

let eqFloat = fn(a: Float, b: Float): Bool

let showFloat = fn(a: Float): String

