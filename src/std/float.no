pub type Float

pub let neg = fn(float): Float {
    negFloat(float)
}

pub let abs = fn(float): Float {
    absFloat(float)
}

pub let add = fn(float, other: Float): Float {
    addFloat(float, other)
}

pub let sub = fn(float, other: Float): Float {
    subFloat(float, other)
}

pub let mult = fn(float, other: Float): Float {
    multFloat(float, other)
}

pub let div = fn(float, other: Float): Float {
    divFloat(float, other)
}

pub let exp = fn(float, other: Float): Float {
    expFloat(float, other)
}

impl Eq for Float {
    eq = fn(self, other: Self): Bool {
        eqFloat(self, other)
    }
}

impl Show for Float {
    show = fn(self): String {
        showFloat(self)
    }
}

impl Trace for Float {
    trace = fn(self): String {
        self.show()
    }
}

impl Copy for Float {}

let negFloat = fn(a: Float): Float

let absFloat = fn(a: Float): Float

let addFloat = fn(a: Float, b: Float): Float

let subFloat = fn(a: Float, b: Float): Float

let multFloat = fn(a: Float, b: Float): Float

let divFloat = fn(a: Float, b: Float): Float

let expFloat = fn(a: Float, b: Float): Float

let eqFloat = fn(a: Float, b: Float): Bool

let showFloat = fn(a: Float): String

