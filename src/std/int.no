pub type Int

pub let neg = fn(int): Int {
    negInt(int)
}

pub let abs = fn(int): Int {
    absInt(int)
}

pub let add = fn(int, other: Int): Int {
    addInt(int, other)
}

pub let sub = fn(int, other: Int): Int {
    subInt(int, other)
}

pub let mult = fn(int, other: Int): Int {
    multInt(int, other)
}

pub let div = fn(int, other: Int): Int {
    divInt(int, other)
}

pub let exp = fn(int, other: Int): Int {
    expInt(int, other)
}

pub let mod = fn(int, divisor: Int): Int {
    modInt(int, divisor)
}

impl Eq for Int {
    eq = fn(self, other: Self): Bool {
        eqInt(self, other)
    }
}

impl Ord for Int {
    cmp = fn(self, other: Self): Ordering {
        cmpInt(self, other)
    }
}

impl Show for Int {
    show = fn(self): String {
        showInt(self)
    }
}

impl Trace for Int {
    trace = fn(self): String {
        self.show()
    }
}

impl Copy for Int {}

let negInt = fn(a: Int): Int

let absInt = fn(a: Int): Int

let addInt = fn(a: Int, b: Int): Int

let subInt = fn(a: Int, b: Int): Int

let multInt = fn(a: Int, b: Int): Int

let divInt = fn(a: Int, b: Int): Int

let expInt = fn(a: Int, b: Int): Int

let modInt = fn(a: Int, b: Int): Int

let eqInt = fn(a: Int, b: Int): Bool

let cmpInt = fn(a: Int, b: Int): Ordering

let showInt = fn(a: Int): String

