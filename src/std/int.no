pub type Int

impl Num for Int {
    neg = fn(self): Self {
        negInt(self)
    }

    abs = fn(self): Self {
        absInt(self)
    }

    add = fn(self, other: Self): Self {
        addInt(self, other)
    }

    sub = fn(self, other: Self): Self {
        subInt(self, other)
    }

    mult = fn(self, other: Self): Self {
        multInt(self, other)
    }

    div = fn(self, other: Self): Self {
        divInt(self, other)
    }

    exp = fn(self, other: Self): Self {
        expInt(self, other)
    }
}

pub let mod = fn(int: Int, divisor: Int): Int {
    modInt(int, divisor)
}

impl Eq for Int {
    eq = fn(self, other: Self): Bool {
        eqInt(self, other)
    }
}

impl Ord for Int {
    cmp = fn(self, other: Self): Ordering {
        cmpInt(self, other)
    }
}

impl Show for Int {
    show = fn(self): String {
        showInt(self)
    }
}

impl Trace for Int {
    trace = fn(self): String {
        self.show()
    }
}

impl Copy for Int {}

let negInt = fn(a: Int): Int

let absInt = fn(a: Int): Int

let addInt = fn(a: Int, b: Int): Int

let subInt = fn(a: Int, b: Int): Int

let multInt = fn(a: Int, b: Int): Int

let divInt = fn(a: Int, b: Int): Int

let expInt = fn(a: Int, b: Int): Int

let modInt = fn(a: Int, b: Int): Int

let eqInt = fn(a: Int, b: Int): Bool

let cmpInt = fn(a: Int, b: Int): Ordering

let showInt = fn(a: Int): String

