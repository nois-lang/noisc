use std::iter::{ MapAdapter, IntersperseAdapter }

pub type List<T>

pub let at = fn<T>(list: List<T>, index: Int): Option<T> {
    listAt(list, index)
}

pub let add = fn<T>(list: List<T>, item: T): Unit {
    listAdd(list, item)
}

pub let count = fn<T>(list: List<T>): Int {
    list.iter().count()
}

pub let popAt = fn<T>(list: List<T>, index: Int): Option<T> {
    listPopAt(list, index)
}

pub let pop = fn<T>(list: List<T>): Option<T> {
    list.popAt(list.count() - 1)
}

pub let popFront = fn<T>(list: List<T>): Option<T> {
    list.popAt(0)
}

pub let clear = fn<T>(list: List<T>): List<T> {
    while list.count() > 0 {
        list.popFront()
    }
    list
}

impl <T> Iterable<T> for List<T> {
    iter = fn(self): Iter<T> {
        ListIter(list: self, index: 0)
    }
}

impl <T> Collector<T> for List<T> {
    fromIter = fn(iter: Iter<T>): Self {
        let list = []
        while true {
            match iter.next() {
                Some(value) { list.add(value) }
                None() { break }
            }
        }
        list
    }
}

impl <T: Show> Show for List<T> {
    show = fn(self): String {
        "[{self.iter().map(Show::show).intersperse(", ").collect<String>()}]"
    }
}

impl <T: Trace> Trace for List<T> {
    trace = fn(self): String {
        "[{self.iter().map(Trace::trace).intersperse(", ").collect<String>()}]"
    }
}

impl <T: Copy> Copy for List<T> {}

pub type ListIter<T>(
    list: List<T>,
    // TODO: this logic breaks if list size changes during iteration.
    // Do something similar to Java's ConcurrentModificationException:
    // if eqRef(self.lastItem, self.list.at(self.index - 1)) { panic("list modified during iteration") }
    index: Int,
)

impl <T> Iter<T> for ListIter<T> {
    next = fn(self): Option<T> {
        match self.list.at(self.index) {
            Some(value) {
                self.index = self.index + 1
                Some(value)
            }
            _ { None() }
        }
    }
}

let listAt = fn<T>(list: List<T>, index: Int): Option<T>

let listAdd = fn<T>(list: List<T>, item: T): Unit

let listPopAt = fn<T>(list: List<T>, index: Int): Option<T>
