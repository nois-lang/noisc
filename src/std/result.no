use std::unwrap::Unwrap

pub type Result<T, E> {
    Ok(pub value: T),
    Error(pub error: E)
}

pub let isOk = fn<T, E>(result: Result<T, E>): Bool {
    match result {
        Ok() { true }
        Error() { false }
    }
}

pub let isError = fn<T, E>(result: Result<T, E>): Bool {
    match result {
        Ok() { false }
        Error() { true }
    }
}

pub let ok = fn<T, E>(result: Result<T, E>): Option<T> {
    match result {
        Ok(value) { Some(value: value) }
        Error() { None() }
    }
}

pub let error = fn<T, E>(result: Result<T, E>): Option<E> {
    match result {
        Ok() { None() }
        Error(error) { Some(value: error) }
    }
}

impl <T> Unwrap<T> for Result<T, _> {
    bind = fn(self): Option<T> {
        self.ok()
    }
}

impl <T: Trace, E: Trace> Trace for Result<T, E> {}

