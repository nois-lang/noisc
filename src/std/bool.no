pub type Bool

pub let and = fn(bool: Bool, other: Bool): Bool {
    andBool(bool, other)
}

pub let or = fn(bool: Bool, other: Bool): Bool {
    orBool(bool, other)
}

pub let not = fn(bool: Bool): Bool {
    notBool(bool)
}

impl Show for Bool {
    show = fn(self): String {
        showBool(self)
    }
}

impl Trace for Bool {}

impl Eq for Bool {
    eq = fn(self, other: Self): Bool {
        eqBool(self, other)
    }
}

impl Copy for Bool {}

let andBool = fn(a: Bool, b: Bool): Bool

let orBool = fn(a: Bool, b: Bool): Bool

let notBool = fn(a: Bool): Bool

let showBool = fn(a: Bool): String

