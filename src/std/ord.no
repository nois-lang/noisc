pub type Ordering {
    Less,
    Equal,
    Greater
}

pub trait Ord {
    cmp = fn(self, other: Self): Ordering

    ge = fn(self, other: Self): Bool {
        match self.cmp(other) {
            Ordering::Less() { false }
            _ { true }
        }
    }

    le = fn(self, other: Self): Bool {
        match self.cmp(other) {
            Ordering::Greater() { false }
            _ { true }
        }
    }

    gt = fn(self, other: Self): Bool {
        match self.cmp(other) {
            Ordering::Greater() { true }
            _ { false }
        }
    }

    lt = fn(self, other: Self): Bool {
        match self.cmp(other) {
            Ordering::Less() { true }
            _ { false }
        }
    }
}

