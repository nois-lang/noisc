use std::unwrap::Unwrap

pub type Option<T> {
    Some(pub value: T),
    None
}

pub let map = fn<T, U>(option: Option<T>, f: fn(value: T): U): Option<U> {
    match option {
        Some(value) { Some(f(value)) }
        None() { option }
    }
}

pub let isSome = fn<T>(option: Option<T>): Bool {
    match option {
        Some() { true }
        None() { false }
    }
}

pub let isNone = fn<T>(option: Option<T>): Bool {
    option.isSome().not()
}

pub let or = fn<T>(option: Option<T>, other: Option<T>): Option<T> {
    match option {
        Some() { option }
        None() { other }
    }
}

pub let unwrap = fn<T>(option: Option<T>): T {
    match option {
        Some(value) { value }
        None() { panic("no value") }
    }
}

impl <T> Unwrap<T> for Option<T> {
    // TODO: use identity fn
    bind = fn(self): Option<T> {
        self
    }
}

impl <T: Trace> Trace for Option<T> {}

