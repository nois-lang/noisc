pub type String

// TODO: belongs to the Monoid trait
pub let concat = fn(string: String, other: String): String {
    concatString(string, other)
}

impl Show for String {
    // TODO: use identity function
    show = fn(self): String {
        self
    }
}

impl Trace for String {
    trace = fn(self): String {
        "\"{self}\""
    }
}

impl Eq for String {
    eq = fn(self, other: Self): Bool {
        eqString(self, other)
    }
}

impl Collector<String> for String {
    // TODO: use fold
    fromIter = fn(iter: Iter<String>): String {
        let res = ""
        for i in iter {
            res = res.concat(i)
        }
        res
    }
}

impl Collector<Char> for String {
    fromIter = fn(iter: Iter<Char>): Self {
        iter.map(Show::show).collect<String>()
    }
}

impl Copy for String {}

let concatString = fn(a: String, b: String): String

let eqString = fn(a: String, b: String): Bool
