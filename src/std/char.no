pub type Char

impl Show for Char {
    show = fn(self): String {
        showChar(self)
    }
}

impl Trace for Char {
    trace = fn(self): String {
        self.show()
    }
}

impl Eq for Char {
    eq = fn(self, other: Self): Bool {
        eqChar(self, other)
    }
}

impl Copy for Char {}

let showChar = fn(a: Char): String

let eqChar = fn(a: Char, b: Char): Bool
