// import
use std::fmt::Show

// sum type
type Vec2(x: Float, y: Float)

// function
let size = fn(vec: Vec2): Float {
    vec.x ^ 2. + vec.y ^ 2.
}

// impl
impl Show for Vec2 {
    show = fn(self): String {
        "(" + self.x + ", " + self.y + ")"
    }
}

// variant type
type Shape {
    Rectangle(width: Num, height: Num),
    Circle(radius: Num),
}

// trait
trait Area {
    area = fn(self): Num
}

// impl for variant type
impl Area for Shape {
    area = fn(self): Num {
        match self {
            Rectangle(width, height) { width * height }
            Circle(radius) { math::pi * radius ^ 2 }
        }
    }
}

// function generics and generic bounds
let foo = fn<T: Show + Trace>(a: T, b: T): String {
    a.show(b).concat(b.trace())
}

let main = fn() {
    // define variable
    let n = 4
    // type annotation
    let h: Int = 4

    // literals
    let i = 12
    let f = 12.34
    let c = 'a'
    let s = "abc"
    let b = true
    // list literals
    let l = [1, 2, 3]

    // constructor
    let vec = Vec2(x: 2., y: 4.)

    // field accessor
    vec.x

    // function call
    println("hello")

    // trait function call
    show(vec)

    // call with compose operator
    "hello".println()
    "hello".{println}
    vec.show()

    // while loop
    let e = while d < 5 {
        a = a + 1
    }

    // for loop
    let f = for g in [1, 2, 3] {
        println(g)
        g + 1
    }

    // destructuring
    let Vec2(x) = vec

    // destructuring alias
    let Vec2(b @ x) = vec

    // match
    let b = match 4 {
        1 { "one" }
        n if n % 2 == 0 {
            match (n > 5) {
                True { "good" } 
                _ { "not good" }
            }
        }
        _ { "whatever" }
    }

    // match type
    let b = match vec {
        Vec2(x: 1, y: 1) { "one" }
        Vec2(x: 1) { "x one whatever" }
        Vec2(x) if x != 4 { "x is {x} not 4" }
        _ { "whatever"}
    }

    // closure
    let square: fn(Num): Num = fn(a) { a ^ 2 }
    let here = fn() { println("here") }
}

